# Build artifacts
build/
build-*/
cmake-build-*/

# Qt Creator / IDE
CMakeLists.txt.user
*.autosave
.qtc_clangd/
.cache/

# OS noise
.DS_Store
Thumbs.db

# Sign-in secrets (see auth.example.json / docs/AUTH.md) - never commit
auth.json
# Discord release-bot credentials and the last published message id
updater-bot/config.json
updater-bot/.state.json

# Python bytecode
__pycache__/
*.pyc

# User-supplied Android platform-tools are external, never commit binaries/keys.
/tools/adb/*
!/tools/adb/README.md
