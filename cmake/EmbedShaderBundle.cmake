# Build inputs are the separately compiled regular Qt plugins, never a runtime
# download. The resulting data-only qrc travels INSIDE the application/portable
# EXE. No Qt 5 library is linked into the Qt 6 Customizer.
function(bsi_embed_shader_bundle target)
    set(BSI_SHADER_BUNDLE_DIR "" CACHE PATH "Prebuilt regular shader modules keyed by their true compiled Qt baseline (qt-x.y.z/BSIShaders.dll + qmldir)")
    option(BSI_REQUIRE_SHADER_BUNDLE "Refuse an application build without embedded shader modules" OFF)
    if(BSI_SHADER_BUNDLE_DIR STREQUAL "")
        if(BSI_REQUIRE_SHADER_BUNDLE)
            message(FATAL_ERROR "Build the matching shader payloads first and set BSI_SHADER_BUNDLE_DIR")
        endif()
        message(STATUS "No shader bundle: shader removal/recovery remains available, installation is disabled")
        return()
    endif()
    get_filename_component(root "${BSI_SHADER_BUNDLE_DIR}" ABSOLUTE)
    file(GLOB directories RELATIVE "${root}" "${root}/*")
    list(SORT directories)
    list(LENGTH directories count)
    if(count LESS 1 OR count GREATER 4)
        message(FATAL_ERROR "Shader bundle must contain one to four qt-x.y.z directories")
    endif()
    set(files)
    set(rows)
    foreach(id IN LISTS directories)
        if(NOT id MATCHES "^qt-([56]\\.[0-9][0-9]?[0-9]?\\.[0-9][0-9]?[0-9]?)$" OR NOT IS_DIRECTORY "${root}/${id}")
            message(FATAL_ERROR "Unexpected shader bundle input: ${id}")
        endif()
        set(version "${CMAKE_MATCH_1}")
        file(GLOB entries RELATIVE "${root}/${id}" "${root}/${id}/*")
        list(SORT entries)
        if(NOT "${entries}" STREQUAL "BSIShaders.dll;qmldir")
            message(FATAL_ERROR "Shader payload must contain exactly BSIShaders.dll and qmldir: ${id}")
        endif()
        set(dll "${root}/${id}/BSIShaders.dll")
        set(qml "${root}/${id}/qmldir")
        file(SIZE "${dll}" size)
        if(size LESS 256 OR size GREATER 134217728)
            message(FATAL_ERROR "Shader DLL size is out of bounds: ${id}")
        endif()
        file(READ "${qml}" definition LIMIT 1025)
        string(REPLACE "\r\n" "\n" definition "${definition}")
        if(NOT definition STREQUAL "module BSIShaders\nplugin BSIShaders\nclassname BSIShadersPlugin\n")
            message(FATAL_ERROR "Unrecognized regular shader qmldir: ${id}")
        endif()
        file(SHA256 "${dll}" dll_hash)
        file(SHA256 "${qml}" qml_hash)
        string(SHA256 package_hash "bsi.shader-payload.v1\nBSIShaders.dll:${dll_hash}\nqmldir:${qml_hash}\n")
        list(APPEND rows "{\"dllSha256\":\"${dll_hash}\",\"id\":\"${id}\",\"packageSha256\":\"${package_hash}\",\"qmldirSha256\":\"${qml_hash}\",\"qtVersion\":\"${version}\"}")
        set_source_files_properties("${dll}" PROPERTIES QT_RESOURCE_ALIAS "${id}/BSIShaders.dll")
        set_source_files_properties("${qml}" PROPERTIES QT_RESOURCE_ALIAS "${id}/qmldir")
        list(APPEND files "${dll}" "${qml}")
        # Changes to the binary must regenerate its hash index, not just the qrc.
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${dll}" "${qml}")
    endforeach()
    list(JOIN rows "," rows)
    set(index "${CMAKE_CURRENT_BINARY_DIR}/shader-bundle/index.json")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/shader-bundle")
    file(WRITE "${index}" "{\"entries\":[${rows}],\"schema\":\"bsi.shader-bundle.v1\"}")
    set_source_files_properties("${index}" PROPERTIES QT_RESOURCE_ALIAS "index.json")
    qt_add_resources(${target} bsi_shader_bundle PREFIX "/bsi-shader-bundle" FILES "${index}" ${files})
    target_compile_definitions(${target} PRIVATE BSI_EMBEDDED_SHADER_BUNDLE=1)
    message(STATUS "Embedded shader bundle: ${directories}")
endfunction()
