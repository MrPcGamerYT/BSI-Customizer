#pragma code_page(65001)
#include <windows.h>
1 RT_MANIFEST "@BSI_MANIFEST@"
101 RCDATA "@BSI_PAYLOAD_CAB@"

1 VERSIONINFO
 FILEVERSION @BSI_FILE_VERSION@
 PRODUCTVERSION @BSI_FILE_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MrPcGamerYT\0"
            VALUE "FileDescription", "BSI Customizer — portable application\0"
            VALUE "FileVersion", "@BSI_APP_VERSION@\0"
            VALUE "ProductName", "BSI Customizer\0"
            VALUE "ProductVersion", "@BSI_APP_VERSION@\0"
            VALUE "OriginalFilename", "BSI-Customizer-Portable.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
