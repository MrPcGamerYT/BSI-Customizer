cmake_minimum_required(VERSION 3.21)
get_filename_component(work_name "${WORK}" NAME)
if(NOT work_name STREQUAL "bundle-cmake-fixtures" OR NOT EXISTS "${TEST_EXE}" OR NOT EXISTS "${SOURCE_ROOT}/cmake/EmbedShaderBundle.cmake")
    message(FATAL_ERROR "Expected bounded disposable bundle-test workspace and compiled test executable")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/project")
execute_process(COMMAND "${TEST_EXE}" --write-fixtures "${WORK}/payloads" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not create disposable synthetic bundle payloads")
endif()
file(WRITE "${WORK}/project/main.c" "int bsi_bundle_probe(void) { return 0; }\n")
# Capture the REAL embedding function's resource arguments without depending on
# Qt's rcc/tool installation. The finished Windows EXE separately tests the
# actual compiled resource data, both packed and extracted, on a clean PATH.
set(project [=[
cmake_minimum_required(VERSION 3.21)
project(BsiBundleConfigureProbe LANGUAGES C)
add_library(probe STATIC main.c)
function(qt_add_resources target name)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/resource-arguments.txt" "${ARGN}")
endfunction()
include("@SOURCE_ROOT@/cmake/EmbedShaderBundle.cmake")
bsi_embed_shader_bundle(probe)
]=])
string(CONFIGURE "${project}" project @ONLY)
file(WRITE "${WORK}/project/CMakeLists.txt" "${project}")
function(configure_probe name path require success)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${WORK}/project" -B "${WORK}/${name}"
        "-DBSI_SHADER_BUNDLE_DIR=${path}" "-DBSI_REQUIRE_SHADER_BUNDLE=${require}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if((success AND NOT result EQUAL 0) OR (NOT success AND result EQUAL 0))
        message(FATAL_ERROR "Unexpected ${name} configure result (${result}):\n${output}\n${error}")
    endif()
endfunction()
configure_probe(valid "${WORK}/payloads" ON TRUE)
execute_process(COMMAND "${TEST_EXE}" --check-index "${WORK}/valid/shader-bundle/index.json" "${WORK}/payloads" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "The real generated manifest does not decode against its exact input payloads")
endif()
file(READ "${WORK}/valid/resource-arguments.txt" arguments)
foreach(name IN ITEMS "PREFIX;/bsi-shader-bundle;FILES;" "qt-5.15.2/BSIShaders.dll" "qt-6.8.3/qmldir")
    string(FIND "${arguments}" "${name}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Missing fixed shader resource argument: ${name}")
    endif()
endforeach()
configure_probe(optional "" OFF TRUE)
configure_probe(required "" ON FALSE)
file(MAKE_DIRECTORY "${WORK}/empty")
configure_probe(empty "${WORK}/empty" ON FALSE)
file(WRITE "${WORK}/payloads/qt-5.15.2/unowned.txt" "Do not package arbitrary files")
configure_probe(extra "${WORK}/payloads" ON FALSE)
file(REMOVE "${WORK}/payloads/qt-5.15.2/unowned.txt")
file(READ "${WORK}/payloads/qt-5.15.2/qmldir" definition)
file(WRITE "${WORK}/payloads/qt-5.15.2/qmldir" "module BSIShaders\nprefer C:/unowned\n")
configure_probe(redirect "${WORK}/payloads" ON FALSE)
file(WRITE "${WORK}/payloads/qt-5.15.2/qmldir" "${definition}")
file(MAKE_DIRECTORY "${WORK}/payloads/qt-not-a-version")
configure_probe(bad_identity "${WORK}/payloads" ON FALSE)
file(REMOVE_RECURSE "${WORK}/payloads/qt-not-a-version")
# Reconfigure after a byte change: the index must be re-pinned, never silently
# reuse the old manifest. The data-only decoder validates the new exact bytes.
file(APPEND "${WORK}/payloads/qt-5.15.2/BSIShaders.dll" "overlay")
configure_probe(valid "${WORK}/payloads" ON TRUE)
execute_process(COMMAND "${TEST_EXE}" --check-index "${WORK}/valid/shader-bundle/index.json" "${WORK}/payloads" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "A changed shader build input did not regenerate its exact hash pins")
endif()
message(STATUS "PASS shader bundle CMake generator, optional/required policy, identities, exact files/qmldir, pins and changed-input regeneration")
